# Nginx configuration template
# $PORT is substituted at startup

# No `user` directive: nginx here is never started as root (the container's
# ENTRYPOINT already runs as the non-root appuser via `USER appuser`), so
# `user` has nothing to switch from and only produces a startup warning.
worker_processes auto;
error_log /var/log/nginx/error.log warn;
# /var/run isn't writable by the non-root appuser; entrypoint.sh creates
# /tmp/nginx before starting nginx.
pid /tmp/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 20M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_types text/plain text/css text/xml text/javascript
               application/x-javascript application/xml+rss
               application/javascript application/json;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

    server {
        listen $PORT default_server;
        listen [::]:$PORT default_server;

        server_name _;

        # Proxy to FastAPI backend
        location /api/ {
            limit_req zone=api burst=20 nodelay;

            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;
            proxy_redirect off;

            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Serve static files (SvelteKit build output)
        location / {
            root /var/www/html;

            # SPA fallback: serve index.html for all non-file routes
            try_files $uri $uri/ /index.html;

            # Cache static assets aggressively
            location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
                expires 30d;
                add_header Cache-Control "public, immutable";
            }

            # Don't cache HTML
            location ~* \.html?$ {
                expires -1;
                add_header Cache-Control "public, must-revalidate";
            }
        }

        # Health check endpoint (no auth required)
        location /api/health {
            proxy_pass http://127.0.0.1:8000;
            access_log off;
        }
    }
}
