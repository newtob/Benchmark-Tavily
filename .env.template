# API Configuration
# Only TAVILY_API_KEY is needed. search_in_prompt (Claude Code's own
# WebSearch tool) is recorded by shelling out to the `claude` CLI - it uses
# whatever auth `claude` already has (SSO/OAuth/Enterprise), so no separate
# Anthropic API key is needed or read by this app.
TAVILY_API_KEY=your_tavily_api_key_here

# Uvicorn Server
API_HOST=0.0.0.0
API_PORT=8000

# OpenTelemetry (OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
