{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "groupName": "non-major devDependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackageNames": ["typescript", "@biomejs/biome"],
      "groupName": "non-major npm dependencies"
    },
    {
      "matchManagers": ["pep621", "pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major python dependencies"
    },
    {
      "matchPackageNames": ["typescript", "@biomejs/biome"],
      "rangeStrategy": "pin"
    }
  ]
}
