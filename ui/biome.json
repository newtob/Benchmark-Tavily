{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"a11y": {
				"noAriaHiddenOnFocusable": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"lineWidth": 100
	},
	"organizeImports": {
		"enabled": true
	},
	"files": {
		"ignore": [
			".svelte-kit",
			"build",
			"dist",
			"node_modules",
			"playwright-report",
			"test-results",
			"test-results.json",
			"**/*.css"
		]
	},
	"overrides": [
		{
			"include": ["*.svelte"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"organizeImports": { "enabled": false }
		}
	]
}
