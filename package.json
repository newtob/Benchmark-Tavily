    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
